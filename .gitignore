# ==================================================
# API
# ==================================================

# Virtual environment
/api/api_venv/

# Python-generated files
/api/**/__pycache__/
/api/**/*.py[cod]


# ==================================================
# ML
# ==================================================

# Virtual environments (covers ml_venv, .venv, venv, etc. at any depth)
/ml/ml_venv/
/ml/**/.venv/
/ml/**/venv/

# Python-generated files
/ml/**/__pycache__/
/ml/**/*.py[cod]

# Processed / generated image outputs (large, regeneratable — don't commit)
/ml/**/data_processed/
/ml/**/dataset_processed/
/ml/**/*_processed/
/ml/**/*_output/

# Raw dataset (large — reference via README/download link instead of committing)
/ml/**/data/
/ml/**/dataset/

# Jupyter
/ml/**/.ipynb_checkpoints/


# ==================================================
# WEB
# ==================================================

# Dependencies
/web/node_modules/
/web/.pnp
/web/.pnp.*
/web/.yarn/*
!/web/.yarn/patches
!/web/.yarn/plugins
!/web/.yarn/releases
!/web/.yarn/versions

# Testing
/web/coverage/

# Next.js
/web/.next/
/web/out/

# Production
/web/build/

# Miscellaneous
/web/**/.DS_Store
/web/**/*.pem

# Debug
/web/npm-debug.log*
/web/yarn-debug.log*
/web/yarn-error.log*
/web/.pnpm-debug.log*

# Vercel
/web/.vercel/

# TypeScript
/web/*.tsbuildinfo
/web/next-env.d.ts


# ==================================================
# GENERAL
# ==================================================

# Shared environment file
/.env

# Operating-system files
.DS_Store
Thumbs.db

# IDE settings
/.idea/
/.vscode/

# API keys / secrets
API KEY
*.key